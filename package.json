    "main": "index.js",
    "scripts": {
        "clean:templates": "chokidar \"./public/_templates\" -c \"rimraf ./public/_templates\"",
        "pug": "pug src/pug/ -P --out ./public/ --basedir ./src/pug --watch",
        "scss": "sass ./src/scss:./public/css --watch",
        "react": "vite build --watch",
        "watch:css": "node build-css.js",
        "live-server": "live-server",
        "start": "npm-run-all --parallel pug scss clean:templates live-server"
    },
