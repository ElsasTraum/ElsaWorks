        "live-server": "^1.2.2",
        "npm-run-all": "^4.1.5",
        "pug": "^3.0.3",
        "pug-cli": "^1.0.0-alpha6",
        "rimraf": "^6.1.3",
        "tailwindcss": "^3.4.17"
    },
